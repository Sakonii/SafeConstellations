    "    'word_shuffle':       '#D35400', 'char_shuffle':       '#7F8C8D',\n",
    "    'conversational_qa':  '#C0392B',   # largest OR task in the study -- give it a distinct color\n",
    "}\n",
    "FIG_DIR = './figures'\n",
    "os.makedirs(FIG_DIR, exist_ok=True)\n",
